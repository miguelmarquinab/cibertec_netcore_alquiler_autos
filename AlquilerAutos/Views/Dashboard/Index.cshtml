@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="grid-cards">
    <div class="stat-card">
        <span>Total Autos</span>
        <h3>@Model.TotalAutos</h3>
    </div>
    <div class="stat-card">
        <span>Disponibles</span>
        <h3>@Model.AutosDisponibles</h3>
    </div>
    <div class="stat-card">
        <span>Clientes</span>
        <h3>@Model.TotalClientes</h3>
    </div>
    <div class="stat-card">
        <span>Alquileres</span>
        <h3>@Model.TotalAlquileres</h3>
    </div>
    <div class="stat-card stat-wide">
        <span>Ingresos Totales</span>
        <h3>S/ @Model.IngresosTotales.ToString("N2")</h3>
    </div>
</div>

<div class="card-panel mt-4">
    <h4>Accesos rápidos</h4>
    <div class="quick-actions">
        <a asp-controller="Autos" asp-action="Index" class="btn btn-outline-light">Ver autos</a>
        <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline-light">Ver clientes</a>
        <a asp-controller="Alquileres" asp-action="Create" class="btn btn-primary">Registrar alquiler</a>
        <a asp-controller="Reportes" asp-action="Index" class="btn btn-success">Reporte general</a>
    </div>
</div>