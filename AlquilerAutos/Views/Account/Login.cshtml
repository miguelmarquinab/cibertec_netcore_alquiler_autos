@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - AlquilerAutos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-body">
    <div class="login-wrapper">
        <div class="login-card">
            
            <div class="login-side">
                <h1>Alquiler de Autos</h1>
                <p>Gestión administrativa de flota y alquileres.</p>
            </div>

            <div class="login-form-side">
                <h3>Bienvenido</h3>
                <p class="text-muted">Inicia sesión para continuar</p>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <div class="mb-3">
                        <label asp-for="Usuario" class="form-label"></label>
                        <input asp-for="Usuario" class="form-control form-control-lg" placeholder="Usuario" />
                        <span asp-validation-for="Usuario" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Clave" class="form-label"></label>
                        <input asp-for="Clave" type="password" class="form-control form-control-lg" placeholder="Contraseña" />
                        <span asp-validation-for="Clave" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100">Ingresar</button>

                    <div class="demo-box mt-4">
                        <strong>Acceso de prueba:</strong><br />
                        admin / 123456<br />
                        recep / 123456
                    </div>
                </form>
            </div>

        </div>
    </div>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
