@model List<AlquilerViewModel>
@{
    ViewData["Title"] = "Reporte General de Alquileres";
    decimal total = Model.Sum(x => x.Total);
}

<div class="card-panel mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-3">
            <input type="date" name="fechaInicio" value="@ViewBag.FechaInicio" class="form-control" />
        </div>
        <div class="col-md-3">
            <input type="date" name="fechaFin" value="@ViewBag.FechaFin" class="form-control" />
        </div>
        <div class="col-md-4">
            <input type="text" name="texto" value="@ViewBag.Texto" class="form-control" placeholder="Buscar cliente, dni, placa, modelo..." />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button class="btn btn-primary">Filtrar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>
    </form>
</div>

<div class="grid-cards mb-4">
    <div class="stat-card">
        <span>Total registros</span>
        <h3>@Model.Count</h3>
    </div>
    <div class="stat-card stat-wide">
        <span>Monto total</span>
        <h3>S/ @total.ToString("N2")</h3>
    </div>
</div>

<div class="card-panel">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Cliente</th>
                    <th>Auto</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th>Días</th>
                    <th>Garantía</th>
                    <th>Total</th>
                    <th>Usuario</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdAlquiler</td>
                        <td>@item.Cliente</td>
                        <td>@item.Auto</td>
                        <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@item.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td>@item.Dias</td>
                        <td>S/ @item.Garantia.ToString("N2")</td>
                        <td>S/ @item.Total.ToString("N2")</td>
                        <td>@item.UsuarioRegistro</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>